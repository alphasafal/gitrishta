# Server-side only (Vercel → Settings → Environment Variables). Never commit real values.
# Optional: a fine-grained GitHub token with NO permissions. Raises the preview-image
# rate limit from 60 to 5,000 requests an hour. Public data needs no scopes.
GITHUB_TOKEN=
# Optional: your public site URL, e.g. https://gitrishta.vercel.app
PUBLIC_URL=
